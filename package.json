{
  "name": "yotablender",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Touch-first low-poly character modeler for phones, with a Blender round-trip.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "preact": "^11.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "eslint": "^10.15.0",
    "fast-check": "^4.11.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  }
}
